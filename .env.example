# SmartAttend Environment Variables Configuration
# Copy this file to .env and fill in the values below.

# Neon Serverless PostgreSQL connection string (Compute endpoint - do not use -pooler)
EXPO_PUBLIC_NEON_DATABASE_URL=postgresql://<user>:<password>@<neon-compute-endpoint>.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Better Auth API Endpoint
EXPO_PUBLIC_NEON_AUTH_URL=https://<neon-auth-endpoint>.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
