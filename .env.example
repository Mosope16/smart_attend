# SmartAttend Environment Variables Configuration
# Copy this file to .env and fill in the values below.

# Neon Serverless PostgreSQL connection string (Compute endpoint - do not use -pooler)
# SECURITY NOTE FOR PRODUCTION:
# 1. Do NOT use the default 'neondb_owner' superuser credentials in client mobile apps.
# 2. For direct client access with RLS, use an unprivileged role or Neon Authorize (JWT-based).
# 3. For complete credential shielding, route database queries through an API backend/Edge route.
EXPO_PUBLIC_NEON_DATABASE_URL=postgresql://<app_user>:<password>@<neon-compute-endpoint>.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Better Auth API Endpoint
EXPO_PUBLIC_NEON_AUTH_URL=https://<neon-auth-endpoint>.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth

